  <property name="styleSheet">
   <string notr="true">/* Головне вікно та фоновий колір */
QWidget#Form, QWidget#centralwidget {
background-color: #f4f8f5;
font-family: 'Segoe UI', Arial, sans-serif;
}
/* Заголовок */
QLabel#lblTitle {
color: #1b5e20;
font-size: 7pt;
font-weight: bold;
margin-bottom: 8px;
}
/* Поля введення */
QLineEdit {
background-color: #ffffff;
border: 2px solid #a5d6a7;
border-radius: 6px;
padding: 3px 8px;
font-size: 6pt;
color: #2e7d32;
}
QLineEdit:focus {
border: 2px solid #2e7d32;
background-color: #ffffff;
}
/* Кнопка дії (Основна) */
QPushButton#btnLogin, QPushButton#btnRegister {
background-color: #2e7d32;
color: #ffffff;
font-size: 8pt;
font-weight: bold;
border: none;
border-radius: 6px;
padding: 8px;
}
QPushButton#btnLogin:hover, QPushButton#btnRegister:hover {
background-color: #388e3c;
}
QPushButton#btnLogin:pressed, QPushButton#btnRegister:pressed {
background-color: #1b5e20;
}
/* Чекбокс */
QCheckBox {
font-size: 8pt;
color: #37474f;
spacing: 5px;
}
QCheckBox::indicator:checked {
background-color: #2e7d32;
border: 1px solid #1b5e20;
border-radius: 3px;
}</string>
